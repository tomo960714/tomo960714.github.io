---
import ExperienceItem from "@components/ExperienceItem.astro";
import Section from "@components/Section.astro";
import SkillTag from "@components/SkillTag.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { experience } from "@data/experience";
import { profile } from "@data/profile";
---

<BaseLayout title={`About | ${profile.name}`} description="Biography, education, interests, and experience.">
  <Section eyebrow="About" title="A little more context" description="Edit this content in src/data/profile.ts and src/data/experience.ts.">
    <div class="-mt-3 grid gap-10 lg:grid-cols-[1.4fr_0.8fr]">
      <div>
        <p class="leading-8 text-zinc-600 dark:text-zinc-300">{profile.bio}</p>
        <h2 class="mt-10 text-xl font-semibold text-zinc-950 dark:text-white">Experience</h2>
        <div class="mt-5 space-y-7">
          {experience.map((item) => <ExperienceItem {...item} />)}
        </div>
      </div>
      <aside class="space-y-8">
        <section>
          <h2 class="text-xl font-semibold text-zinc-950 dark:text-white">Education</h2>
          <div class="mt-4 space-y-4">
            {profile.education.map((item) => (
              <article class="rounded-lg border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/70">
                <h3 class="font-medium text-zinc-950 dark:text-white">
                  {
                    item.link ? (
                      <a class="hover:text-emerald-700 dark:hover:text-emerald-400" href={item.link} target="_blank" rel="noreferrer">
                        {item.institution}
                      </a>
                    ) : (
                      item.institution
                    )
                  }
                </h3>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-300">{item.credential}</p>
                <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{item.period}</p>
              </article>
            ))}
          </div>
        </section>
        <section>
          <h2 class="text-xl font-semibold text-zinc-950 dark:text-white">Interests</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {profile.interests.map((interest) => <SkillTag label={interest} />)}
          </div>
        </section>
      </aside>
    </div>
  </Section>
</BaseLayout>
