---
import EducationList from "@components/EducationList.astro";
import Section from "@components/Section.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { education } from "@data/education";
import { experience } from "@data/experience";
import { profile } from "@data/profile";

const profileImage = {
  src: "profile.webp",
  alt: `Portrait of ${profile.name}`,
};

const aboutIntro = profile.bio;
const primaryEducation = education[0];

const profileFacts = [
  { label: "Location", value: "Denmark" },
  { label: "Focus", value: "Data Science · Machine Learning · Backend Development" },
  { label: "Background", value: `${primaryEducation.degree} · ${primaryEducation.specialization}` },
];

const languages = [
  { name: "Hungarian", level: "Native" },
  { name: "English", level: "Professional" },
  { name: "Danish", level: "Conversational" },
];

---

<BaseLayout title={`About | ${profile.name}`} description="Biography, education, interests, and experience.">
  <Section class="pb-20">
    <div class="space-y-10">
      <section class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr]" aria-labelledby="about-heading">
        <div class="overflow-hidden rounded-lg border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900/70">
          {
            profileImage.src ? (
              <img class="aspect-[4/5] h-full w-full object-cover" src={profileImage.src} alt={profileImage.alt} />
            ) : (
              <div class="flex aspect-[4/5] min-h-80 items-center justify-center bg-zinc-100 p-6 text-center dark:bg-zinc-900">
                <div>
                  <p class="text-sm font-medium uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-400">Profile image</p>
                  <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-300">Add a portrait path to <code>profileImage.src</code> in this page.</p>
                </div>
              </div>
            )
          }
        </div>

        <div class="rounded-lg border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/70 sm:p-8">
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-400">About me</p>
          <h1 id="about-heading" class="mt-3 text-3xl font-semibold leading-tight text-zinc-950 dark:text-white sm:text-4xl">{profile.name}</h1>
          <p class="mt-3 text-lg text-zinc-700 dark:text-zinc-300">{profile.title}</p>
          <p class="mt-6 leading-8 text-zinc-600 dark:text-zinc-300">{aboutIntro}</p>
        </div>
      </section>

      <section class="grid gap-5 lg:grid-cols-[1.1fr_0.9fr]" aria-label="Profile details">
        <article class="rounded-lg border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/70">
          <h2 class="text-xl font-semibold text-zinc-950 dark:text-white">Profile</h2>
          <dl class="mt-5 grid gap-5 sm:grid-cols-3">
            {profileFacts.map((fact) => (
              <div>
                <dt class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{fact.label}</dt>
                <dd class="mt-2 leading-7 text-zinc-700 dark:text-zinc-300">{fact.value}</dd>
              </div>
            ))}
          </dl>
        </article>

        <article class="rounded-lg border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/70">
          <h2 class="text-xl font-semibold text-zinc-950 dark:text-white">Languages</h2>
          <ul class="mt-5 space-y-3">
            {languages.map((language) => (
              <li class="flex items-center justify-between gap-4 border-b border-zinc-200 pb-3 last:border-0 last:pb-0 dark:border-zinc-800">
                <span class="font-medium text-zinc-950 dark:text-white">{language.name}</span>
                <span class="text-sm text-zinc-500 dark:text-zinc-400">{language.level}</span>
              </li>
            ))}
          </ul>
        </article>
      </section>

      <section class="grid gap-5 lg:grid-cols-2">
        <div>
          <h2 class="text-xl font-semibold text-zinc-950 dark:text-white">Experience</h2>
          <div class="mt-5 space-y-4">
            {experience.map((item) => (
              <article class="rounded-lg border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/70">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                  <h3 class="font-semibold text-zinc-950 dark:text-white">
                    {
                      item.link ? (
                        <a class="hover:text-emerald-700 dark:hover:text-emerald-400" href={item.link} target="_blank" rel="noreferrer">
                          {item.role} · {item.company}
                        </a>
                      ) : (
                        `${item.role} · ${item.company}`
                      )
                    }
                  </h3>
                  <p class="text-sm text-zinc-500 dark:text-zinc-400">{item.period}</p>
                </div>
                <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{item.location}</p>
                <p class="mt-3 leading-7 text-zinc-600 dark:text-zinc-300">{item.summary}</p>
              </article>
            ))}
          </div>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-zinc-950 dark:text-white">Education</h2>
          <div class="mt-5">
            <EducationList items={education} />
          </div>
        </div>
      </section>
    </div>
  </Section>
</BaseLayout>
