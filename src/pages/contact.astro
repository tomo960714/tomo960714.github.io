---
import ContactLinks from "@components/ContactLinks.astro";
import Section from "@components/Section.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { links } from "@data/links";
import { profile } from "@data/profile";
---

<BaseLayout title={`Contact | ${profile.name}`} description="Contact links and email address.">
  <Section eyebrow="Contact" title="Get in touch" description="No backend form is needed. This page uses a simple email link plus public profile links.">
    <div class="rounded-lg border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/70">
      <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Email</p>
      <a class="mt-2 inline-flex text-lg font-semibold text-zinc-950 hover:text-emerald-700 dark:text-white dark:hover:text-emerald-400" href={`mailto:${profile.email}`}>
        {profile.email}
      </a>
      <div class="mt-6">
        <ContactLinks showEmail={false} />
      </div>
      {links.cv && (
        <a class="mt-4 inline-flex text-sm font-medium text-emerald-700 hover:text-emerald-900 dark:text-emerald-400 dark:hover:text-emerald-300" href={links.cv}>
          Download CV
        </a>
      )}
    </div>
  </Section>
</BaseLayout>
