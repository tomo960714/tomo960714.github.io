---
import type { Education } from "@data/education";

interface Props {
  items: readonly Education[];
  compact?: boolean;
}

const { items, compact = false } = Astro.props;
const formatPeriod = (item: Education) => `${item.startDate} - ${item.endDate}`;
---

<div class:list={[compact ? "space-y-3" : "space-y-4"]}>
  {items.map((item) => (
    <article class:list={["rounded-lg border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900/70", compact ? "p-4" : "p-5"]}>
      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
        <h3 class="font-semibold text-zinc-950 dark:text-white">{item.degree}</h3>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">{formatPeriod(item)}</p>
      </div>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{item.institution} · {item.location}</p>
      <p class={compact ? "mt-3 leading-7 text-zinc-600 dark:text-zinc-300" : "mt-2 leading-7 text-zinc-600 dark:text-zinc-300"}>{item.specialization}</p>
      {!compact && <p class="mt-3 leading-7 text-zinc-600 dark:text-zinc-300">{item.description}</p>}
      {!compact && item.highlights.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label={`${item.degree} highlights`}>
          {item.highlights.map((highlight) => (
            <li class="rounded-full border border-zinc-200 px-3 py-1 text-sm text-zinc-700 dark:border-zinc-800 dark:text-zinc-300">{highlight}</li>
          ))}
        </ul>
      )}
    </article>
  ))}
</div>
