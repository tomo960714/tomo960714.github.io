---
interface Props {
  role: string;
  company: string;
  period: string;
  location: string;
  summary: string;
  link?: string;
}

const { role, company, period, location, summary, link } = Astro.props;
---

<article class="border-l border-zinc-200 pl-5 dark:border-zinc-800">
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
    <h3 class="font-semibold text-zinc-950 dark:text-white">
      {role} · {" "}
      {
        link ? (
          <a class="hover:text-emerald-700 dark:hover:text-emerald-400" href={link} target="_blank" rel="noreferrer">
            {company}
          </a>
        ) : (
          company
        )
      }
    </h3>
    <p class="text-sm text-zinc-500 dark:text-zinc-400">{period}</p>
  </div>
  <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{location}</p>
  <p class="mt-3 leading-7 text-zinc-600 dark:text-zinc-300">{summary}</p>
</article>
