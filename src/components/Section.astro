---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  class?: string;
}

const { eyebrow, title, description, class: className = "" } = Astro.props;
---

<section class:list={["py-12 sm:py-16", className]}>
  <div class="mx-auto max-w-5xl px-5">
    {(eyebrow || title || description) && (
      <div class="mb-8 max-w-2xl">
        {eyebrow && <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-400">{eyebrow}</p>}
        {title && <h2 class="text-2xl font-semibold text-zinc-950 dark:text-white sm:text-3xl">{title}</h2>}
        {description && <p class="mt-3 leading-7 text-zinc-600 dark:text-zinc-300">{description}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
