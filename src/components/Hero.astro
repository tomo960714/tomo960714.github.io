---
import ContactLinks from "@components/ContactLinks.astro";
import EducationList from "@components/EducationList.astro";
import { education } from "@data/education";
import { profile } from "@data/profile";
---

<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-5">
    <div class="max-w-4xl">
      <h1 class="text-4xl font-semibold leading-tight text-zinc-950 dark:text-white sm:text-6xl">{profile.name}</h1>
      <p class="mt-5 text-xl text-zinc-700 dark:text-zinc-300 sm:text-2xl">{profile.title}</p>
      <p class="mt-6 max-w-3xl leading-8 text-zinc-600 dark:text-zinc-300">{profile.summary}</p>
      <div class="mt-8">
        <ContactLinks />
      </div>
      <section class="mt-10 max-w-3xl" aria-labelledby="profile-education-heading">
        <h2 id="profile-education-heading" class="text-xl font-semibold text-zinc-950 dark:text-white">Education</h2>
        <div class="mt-4">
          <EducationList items={education} compact />
        </div>
      </section>
    </div>
  </div>
</section>
