---
import type { CollectionEntry } from "astro:content";
import SkillTag from "@components/SkillTag.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, role, technologies, date } = project.data;
const projectSlug = project.id.replace(/\.mdx?$/, "");
const projectHref = `${import.meta.env.BASE_URL}projects/${projectSlug}`;
---

<article class="group rounded-lg border border-zinc-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900/70 dark:hover:border-zinc-700">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h3 class="text-lg font-semibold text-zinc-950 dark:text-white">
        <a href={projectHref} class="hover:text-emerald-700 dark:hover:text-emerald-400">{title}</a>
      </h3>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{role}</p>
    </div>
    <time class="text-sm text-zinc-500 dark:text-zinc-400" datetime={date.toISOString()}>{date.getFullYear()}</time>
  </div>
  <p class="mt-4 leading-7 text-zinc-600 dark:text-zinc-300">{description}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {technologies.map((technology) => <SkillTag label={technology} />)}
  </div>
</article>
